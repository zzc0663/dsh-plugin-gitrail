{
  "name": "dsh-plugin-gitrail",
  "version": "0.4.0",
  "description": "Rail for your repo — a read-only git branch and commit view in the DeepSeek Harness right sidebar.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzc0663/dsh-plugin-gitrail.git"
  },
  "homepage": "https://github.com/zzc0663/dsh-plugin-gitrail#readme",
  "bugs": {
    "url": "https://github.com/zzc0663/dsh-plugin-gitrail/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "sidebar",
    "branches",
    "commits",
    "rail"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/git.js && node scripts/check.mjs",
    "test": "node --test",
    "test:git": "node --test test/git.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
